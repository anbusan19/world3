{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/sponsor.html" },
    { "source": "/api/:path*", "destination": "https://cancel-dramatically-road-aid.trycloudflare.com/api/:path*" },
    { "source": "/share/:path*", "destination": "https://cancel-dramatically-road-aid.trycloudflare.com/share/:path*" },
    { "source": "/files/:path*", "destination": "https://cancel-dramatically-road-aid.trycloudflare.com/files/:path*" },
    { "source": "/stamp/:path*", "destination": "https://cancel-dramatically-road-aid.trycloudflare.com/stamp/:path*" }
  ]
}
