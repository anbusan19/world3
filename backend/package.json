{
  "name": "world3-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local spots server and dashboard for World3: place 3D models (.glb) on the map.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
