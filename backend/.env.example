PORT=3000
# World ID (developer portal -> your app). Keep the real values in backend/.env, which is git-ignored.
WORLD_ID_APP_ID=app_xxxxxxxx
WORLD_ID_RP_ID=rp_xxxxxxxx
WORLD_ID_ACTION=capture
WORLD_ID_SIGNING_KEY=0x...        # RP signing key, shown once when the RP is created
WORLD_ID_ENV=production           # "staging" to test with the World ID simulator
MAX_ACCURACY_M=25
NONCE_TTL_SECONDS=120
