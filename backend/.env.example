PORT=3000
# World ID (developer portal -> your app). Keep the real values in backend/.env, which is git-ignored.
WORLD_ID_APP_ID=app_xxxxxxxx
WORLD_ID_RP_ID=rp_xxxxxxxx
WORLD_ID_ACTION=capture            # per-spot actions are capture-<spotId>
WORLD_ID_SIGNIN_ACTION=signin      # a person can prove once per action; change it to start everyone over while testing
WORLD_ID_SIGNING_KEY=0x...        # RP signing key, shown once when the RP is created
WORLD_ID_ENV=production           # "staging" to test with the World ID simulator
MAX_ACCURACY_M=25
NONCE_TTL_SECONDS=120

# Stamp minting. VOUCHER_SIGNER_KEY signs mint vouchers (its address is the contract's signer). Fill STAMP_CONTRACT after deploying.
VOUCHER_SIGNER_KEY=0x...
CHAIN_ID=11155111
STAMP_CONTRACT=0x...

# Arkiv testnet. ARKIV_PRIVATE_KEY is the wallet that writes the organizer's entities (fund it at the faucet).
ARKIV_PRIVATE_KEY=0x...
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=

# Sponsor wallets whose campaigns the app may show (comma separated addresses). The organizer wallet is always approved.
ARKIV_SPONSORS=

# ENSv2 passport (Sepolia). ENS_PRIVATE_KEY owns the parent name and pays gas.
ENS_PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ENS_PARENT_NAME=

# Passports: seed for the custodial owner address of each traveler (any long random string), and the public URL used in share links.
PASSPORT_OWNER_SEED=
PUBLIC_BASE_URL=
# Extra words that may not appear in a passport name (comma separated, any language). The built-in list is English only.
PASSPORT_BLOCKED_WORDS=
